<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!-- 主壳标题栏按钮样式 -->
    <Style x:Key="ShellTitleButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E6E8EB" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#D8DCE0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮特化悬停红底 -->
    <Style x:Key="ShellCloseButtonStyle" BasedOn="{StaticResource ShellTitleButtonStyle}" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#C4101E" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 侧边栏一级菜单项容器（挂在 hc:SideMenu.ItemContainerStyle 上），只改高度，不动容器链。
         严禁在这里再给 ItemContainerStyle 挂二级样式：HandyControl 的 SideMenuItem.Refresh()
         会读取本容器样式并覆写每个子项的 Style，含子项的一级项取到 {DependencyProperty.UnsetValue}，
         主窗口首次 Measure 即抛 InvalidOperationException「{DependencyProperty.UnsetValue} 不是 ItemContainerStyle 的有效值」。
         二级项沿用 BasedOn 链上 SideMenuItemHeaderBaseStyle 自带的 ItemContainerStyle（SideMenuItemBaseStyle）。
         注意：hc:SideMenuItem 没有 HeaderTemplate 依赖属性，不要设置（会报 MC4005）；字体统一后续再论。
         严禁给带子项的容器设固定 Height：模板第二行是展开面板，写死高度会把子菜单裁掉；用 MinHeight。 -->
    <Style x:Key="ShellSideMenuItemHeaderStyle" BasedOn="{StaticResource SideMenuItemHeaderBaseStyle}" TargetType="hc:SideMenuItem">
        <Setter Property="MinHeight" Value="46" />
    </Style>

</ResourceDictionary>
