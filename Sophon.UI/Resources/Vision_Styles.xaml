<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 视觉 UI 专属色彩画刷 -->
    <SolidColorBrush x:Key="VisionSuccessBrush" Color="#52C41A" />
    <SolidColorBrush x:Key="VisionDangerBrush" Color="#F5222D" />
    <SolidColorBrush x:Key="VisionPrimaryBrush" Color="#1890FF" />
    <SolidColorBrush x:Key="VisionWarningBrush" Color="#FAAD14" />
    <SolidColorBrush x:Key="VisionDarkViewportBrush" Color="#141414" />

    <!-- 状态指示徽章通用样式 -->
    <Style x:Key="VisionStatusBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 数值高亮显示文本通用样式 -->
    <Style x:Key="VisionMetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#262626" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
