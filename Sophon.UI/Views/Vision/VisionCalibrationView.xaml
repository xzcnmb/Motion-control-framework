<UserControl
    x:Class="Sophon.UI.Views.Vision.VisionCalibrationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#F3F6F9"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部相机选择与状态栏 -->
        <Border Grid.Row="0" Margin="0,0,0,10" Style="{StaticResource CardBorderStyle}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#333333"
                        Text="标定目标相机：" />

                    <ComboBox
                        Width="180"
                        Height="32"
                        Margin="5,0,20,0"
                        FontSize="14"
                        ItemsSource="{Binding CameraList}"
                        SelectedItem="{Binding SelectedCamera, Mode=TwoWay}" />

                    <Button
                        Height="32"
                        Margin="0,0,10,0"
                        Command="{Binding LoadCalibrationCommand}"
                        Content="读取已存标定"
                        Style="{StaticResource ButtonDashedInfo}" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#8C8C8C"
                        Text="向导状态：" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#1890FF"
                        Text="{Binding CalibrationStatus}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 标定向导三大模块选项卡 -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- 模块一：九点仿射标定 -->
            <TabItem Header="  一、九点仿射标定向导  " FontSize="15">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="480" />
                        <ColumnDefinition Width="2*" MinWidth="380" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：九点标定采集点列表 -->
                    <Border Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource CardBorderStyle}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="#262626"
                                    Text="标定点位采集表 (建议 3×3 矩阵井字分布)" />

                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,10,0"
                                        Command="{Binding GenerateDemoGridCommand}"
                                        Content="自动填充3×3示例"
                                        Style="{StaticResource ButtonDashedSuccess}" />
                                    <Button
                                        Command="{Binding ResetPointsCommand}"
                                        Content="重置点表"
                                        Style="{StaticResource ButtonDashedDanger}" />
                                </StackPanel>
                            </Grid>

                            <!-- 点位列表 -->
                            <DataGrid
                                Grid.Row="1"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding Points}"
                                Style="{StaticResource DataGridCommonStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="60"
                                        Binding="{Binding Index}"
                                        Header="点号" />
                                    <DataGridTemplateColumn Width="80" Header="采集状态">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Padding="6,2"
                                                    HorizontalAlignment="Center"
                                                    Background="{Binding StatusColor}"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="{Binding StatusText}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn
                                        Width="120"
                                        Binding="{Binding PixelX, StringFormat='{}{0:F2}'}"
                                        Header="像素 X (px)" />
                                    <DataGridTextColumn
                                        Width="120"
                                        Binding="{Binding PixelY, StringFormat='{}{0:F2}'}"
                                        Header="像素 Y (px)" />
                                    <DataGridTextColumn
                                        Width="120"
                                        Binding="{Binding WorldX, StringFormat='{}{0:F3}'}"
                                        Header="物理世界 X (mm)" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding WorldY, StringFormat='{}{0:F3}'}"
                                        Header="物理世界 Y (mm)" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border
                                Grid.Row="2"
                                Margin="0,10,0,0"
                                Padding="8,4"
                                Background="#F6FFED"
                                BorderBrush="#B7EB8F"
                                BorderThickness="1"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#389E0D"
                                    Text="提示：依次移动机械轴到 9 个位置，记录机械物理坐标(mm)，并在此处点击拍照触发记录对应图像像素(px)。" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 右侧：当前点录入与标定计算控制 -->
                    <Grid Grid.Column="1" Margin="5,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 当前点录入卡片 -->
                        <Border Grid.Row="0" Margin="0,0,0,10" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Margin="12">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="#262626"
                                    Text="当前标定点录入" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="目标点号 (1~9)：" />
                                    <ComboBox
                                        Grid.Column="1"
                                        Height="30"
                                        Margin="10,0"
                                        FontSize="14"
                                        SelectedValue="{Binding CurrentPointIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="1" />
                                        <ComboBoxItem Content="2" />
                                        <ComboBoxItem Content="3" />
                                        <ComboBoxItem Content="4" />
                                        <ComboBoxItem Content="5" />
                                        <ComboBoxItem Content="6" />
                                        <ComboBoxItem Content="7" />
                                        <ComboBoxItem Content="8" />
                                        <ComboBoxItem Content="9" />
                                    </ComboBox>
                                    <Button
                                        Grid.Column="2"
                                        Height="30"
                                        Command="{Binding TriggerCurrentPointCommand}"
                                        Content="拍照触发测量"
                                        Style="{StaticResource ButtonPrimary}" />
                                </Grid>

                                <!-- 像素坐标 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,5,0">
                                        <TextBlock FontSize="12" Foreground="#8C8C8C" Text="像素 X (px)：" />
                                        <TextBox
                                            Height="30"
                                            Margin="0,3,0,0"
                                            Text="{Binding InputPixelX, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock FontSize="12" Foreground="#8C8C8C" Text="像素 Y (px)：" />
                                        <TextBox
                                            Height="30"
                                            Margin="0,3,0,0"
                                            Text="{Binding InputPixelY, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <!-- 物理世界坐标 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,5,0">
                                        <TextBlock FontSize="12" Foreground="#8C8C8C" Text="物理世界 X (mm)：" />
                                        <TextBox
                                            Height="30"
                                            Margin="0,3,0,0"
                                            Text="{Binding InputWorldX, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock FontSize="12" Foreground="#8C8C8C" Text="物理世界 Y (mm)：" />
                                        <TextBox
                                            Height="30"
                                            Margin="0,3,0,0"
                                            Text="{Binding InputWorldY, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Button
                                    Height="36"
                                    Margin="0,10,0,0"
                                    Command="{Binding RecordCurrentPointCommand}"
                                    Content="录入当前点并移至下一点"
                                    Style="{StaticResource ButtonSuccess}" />
                            </StackPanel>
                        </Border>

                        <!-- 标定计算与残差评估卡片 -->
                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 标题与合格判定 -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        FontWeight="Bold"
                                        Foreground="#262626"
                                        Text="仿射标定计算与精度评估" />

                                    <Border
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="10,3"
                                        CornerRadius="4"
                                        Visibility="{Binding HasCalibrated, Converter={StaticResource BoolToVisConverter}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFF1F0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAcceptable}" Value="True">
                                                        <Setter Property="Background" Value="#F6FFED" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#F5222D" />
                                                    <Setter Property="Text" Value="标定超差 (NG)" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAcceptable}" Value="True">
                                                            <Setter Property="Foreground" Value="#52C41A" />
                                                            <Setter Property="Text" Value="标定合格 (PASS)" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- 阈值设定 -->
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,5,0">
                                        <TextBlock FontSize="12" Foreground="#8C8C8C" Text="最大物理残差容限 (mm)：" />
                                        <TextBox
                                            Height="28"
                                            Margin="0,3,0,0"
                                            Text="{Binding MaxResidualMmThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock FontSize="12" Foreground="#8C8C8C" Text="最大像素残差容限 (px)：" />
                                        <TextBox
                                            Height="28"
                                            Margin="0,3,0,0"
                                            Text="{Binding MaxResidualPxThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <!-- 残差与矩阵展示 -->
                                <StackPanel Grid.Row="2">
                                    <Grid Margin="0,2">
                                        <TextBlock FontSize="12" Foreground="#595959" Text="物理坐标 RMS 残差：" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{Binding RmsResidualMm, StringFormat='{}{0:F5} mm'}" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock FontSize="12" Foreground="#595959" Text="物理坐标最大单点残差：" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#1890FF"
                                            Text="{Binding MaxResidualMm, StringFormat='{}{0:F5} mm'}" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock FontSize="12" Foreground="#595959" Text="像素反投影 RMS 残差：" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{Binding RmsResidualPx, StringFormat='{}{0:F3} px'}" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock FontSize="12" Foreground="#595959" Text="像素反投影最大单点残差：" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{Binding MaxResidualPx, StringFormat='{}{0:F3} px'}" />
                                    </Grid>

                                    <TextBlock
                                        Margin="0,8,0,3"
                                        FontSize="12"
                                        Foreground="#8C8C8C"
                                        Text="2×3 仿射变换矩阵 [ [a11, a12, dx], [a21, a22, dy] ]：" />
                                    <Border
                                        Padding="8"
                                        Background="#F5F5F5"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="#333333"
                                            Text="{Binding MatrixDescription}" />
                                    </Border>
                                </StackPanel>

                                <!-- 操作按钮 -->
                                <Grid Grid.Row="3" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Height="36"
                                        Margin="0,0,5,0"
                                        Command="{Binding CalibrateNinePointCommand}"
                                        Content="计算九点标定"
                                        Style="{StaticResource ButtonPrimary}" />
                                    <Button
                                        Grid.Column="1"
                                        Height="36"
                                        Margin="5,0,0,0"
                                        Command="{Binding SaveCalibrationCommand}"
                                        Content="保存标定到磁盘"
                                        Style="{StaticResource ButtonSuccess}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 模块二：旋转中心标定 -->
            <TabItem Header="  二、旋转中心标定  " FontSize="15">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：两点法旋转采样录入 -->
                    <Border Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Margin="14">
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#262626"
                                Text="两圆法 / 旋转角采样输入" />

                            <!-- 采样点 1 -->
                            <Border
                                Margin="0,0,0,14"
                                Padding="12"
                                Background="#FAFAFA"
                                BorderBrush="#E8E8E8"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="#1890FF"
                                            Text="采样位置 1" />
                                        <Button
                                            HorizontalAlignment="Right"
                                            Command="{Binding SampleRotPoint1Command}"
                                            Content="从最新测量填入"
                                            Style="{StaticResource ButtonDashedPrimary}" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock FontSize="12" Foreground="#8C8C8C" Text="旋转角度 θ1 (°)" />
                                            <TextBox Height="30" Margin="0,3,0,0" Text="{Binding RotAngle1, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                            <TextBlock FontSize="12" Foreground="#8C8C8C" Text="物理坐标 X1 (mm)" />
                                            <TextBox Height="30" Margin="0,3,0,0" Text="{Binding RotWorldX1, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock FontSize="12" Foreground="#8C8C8C" Text="物理坐标 Y1 (mm)" />
                                            <TextBox Height="30" Margin="0,3,0,0" Text="{Binding RotWorldY1, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 采样点 2 -->
                            <Border
                                Margin="0,0,0,14"
                                Padding="12"
                                Background="#FAFAFA"
                                BorderBrush="#E8E8E8"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="#52C41A"
                                            Text="采样位置 2 (旋转机构转动后)" />
                                        <Button
                                            HorizontalAlignment="Right"
                                            Command="{Binding SampleRotPoint2Command}"
                                            Content="从最新测量填入"
                                            Style="{StaticResource ButtonDashedSuccess}" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock FontSize="12" Foreground="#8C8C8C" Text="旋转角度 θ2 (°)" />
                                            <TextBox Height="30" Margin="0,3,0,0" Text="{Binding RotAngle2, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                            <TextBlock FontSize="12" Foreground="#8C8C8C" Text="物理坐标 X2 (mm)" />
                                            <TextBox Height="30" Margin="0,3,0,0" Text="{Binding RotWorldX2, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock FontSize="12" Foreground="#8C8C8C" Text="物理坐标 Y2 (mm)" />
                                            <TextBox Height="30" Margin="0,3,0,0" Text="{Binding RotWorldY2, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="8"
                                Background="#E6F7FF"
                                BorderBrush="#91D5FF"
                                BorderThickness="1"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#0050B3"
                                    Text="原理说明：工件特征点绕机械旋转轴转动指定角度 Δθ，两圆法利用旋转前后点对精确解算出机构旋转中心 (Cx, Cy) 及特征回转半径 R。" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 右侧：计算结果与存储 -->
                    <Border Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Margin="14">
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#262626"
                                Text="旋转中心计算结果" />

                            <Grid Margin="0,6">
                                <TextBlock FontSize="14" Foreground="#595959" Text="旋转中心物理 X (Cx)：" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="#1890FF"
                                    Text="{Binding RotationCenterX, StringFormat='{}{0:F4} mm'}" />
                            </Grid>

                            <Grid Margin="0,6">
                                <TextBlock FontSize="14" Foreground="#595959" Text="旋转中心物理 Y (Cy)：" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="#1890FF"
                                    Text="{Binding RotationCenterY, StringFormat='{}{0:F4} mm'}" />
                            </Grid>

                            <Grid Margin="0,6">
                                <TextBlock FontSize="14" Foreground="#595959" Text="特征回转半径 (Radius)：" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="#52C41A"
                                    Text="{Binding RotationRadius, StringFormat='{}{0:F4} mm'}" />
                            </Grid>

                            <Grid Margin="0,6">
                                <TextBlock FontSize="14" Foreground="#595959" Text="拟合残差差值：" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{Binding RotationRms, StringFormat='{}{0:F5} mm'}" />
                            </Grid>

                            <Button
                                Height="40"
                                Margin="0,20,0,10"
                                Command="{Binding CalibrateRotationCenterCommand}"
                                Content="执行旋转中心标定"
                                Style="{StaticResource ButtonPrimary}" />

                            <Button
                                Height="40"
                                Command="{Binding SaveRotationCenterCommand}"
                                Content="保存旋转中心到标定参数"
                                Style="{StaticResource ButtonSuccess}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 模块三：示教基准与对位纠偏演示 -->
            <TabItem Header="  三、示教基准与对位纠偏  " FontSize="15">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：示教标准基准 -->
                    <Border Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Margin="14">
                            <Grid Margin="0,0,0,12">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="#262626"
                                    Text="产品标准示教基准 (VisionTeachBase)" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Command="{Binding TeachCurrentAsBaseCommand}"
                                    Content="采集当前测量为基准"
                                    Style="{StaticResource ButtonDashedSuccess}" />
                            </Grid>

                            <StackPanel Margin="0,4">
                                <TextBlock FontSize="12" Foreground="#8C8C8C" Text="基准名称 / 产品型号：" />
                                <TextBox Height="30" Margin="0,3,0,0" Text="{Binding TeachBaseName}" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,10,0,4"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#1890FF"
                                Text="标准特征像素基准 (Base Pixel)" />
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock FontSize="11" Foreground="#8C8C8C" Text="基准像素 X (px)" />
                                    <TextBox Height="28" Margin="0,2,0,0" Text="{Binding BasePixelX}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock FontSize="11" Foreground="#8C8C8C" Text="基准像素 Y (px)" />
                                    <TextBox Height="28" Margin="0,2,0,0" Text="{Binding BasePixelY}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock FontSize="11" Foreground="#8C8C8C" Text="基准像素角度 (°)" />
                                    <TextBox Height="28" Margin="0,2,0,0" Text="{Binding BasePixelAngleDeg}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Margin="0,14,0,4"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#52C41A"
                                Text="物理机械示教基准 (Teach World)" />
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock FontSize="11" Foreground="#8C8C8C" Text="机械基准 X (mm)" />
                                    <TextBox Height="28" Margin="0,2,0,0" Text="{Binding TeachWorldX}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock FontSize="11" Foreground="#8C8C8C" Text="机械基准 Y (mm)" />
                                    <TextBox Height="28" Margin="0,2,0,0" Text="{Binding TeachWorldY}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock FontSize="11" Foreground="#8C8C8C" Text="机械基准角度 (°)" />
                                    <TextBox Height="28" Margin="0,2,0,0" Text="{Binding TeachWorldAngleDeg}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 右侧：偏差计算与纠偏目标演示 -->
                    <Border Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Margin="14">
                            <Grid Margin="0,0,0,10">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="#262626"
                                    Text="对位纠偏演示 (OffsetCalculator + XyrCorrection)" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Command="{Binding TriggerAndDemoCorrectionCommand}"
                                    Content="触发单次测量演示"
                                    Style="{StaticResource ButtonPrimary}" />
                            </Grid>

                            <!-- 视觉相对偏差量 -->
                            <TextBlock
                                Margin="0,6,0,4"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#722ED1"
                                Text="视觉相对偏差量 (当前 - 基准)" />
                            <Border
                                Padding="10"
                                Background="#F9F0FF"
                                BorderBrush="#D3ADF7"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <Grid Margin="0,2">
                                        <TextBlock FontSize="12" Foreground="#595959" Text="物理 X 方向偏差 (ΔWorldX)：" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Text="{Binding OffsetDeltaWorldX, StringFormat='{}{0:F4} mm'}" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock FontSize="12" Foreground="#595959" Text="物理 Y 方向偏差 (ΔWorldY)：" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Text="{Binding OffsetDeltaWorldY, StringFormat='{}{0:F4} mm'}" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock FontSize="12" Foreground="#595959" Text="物理角度偏差 (ΔAngle)：" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Text="{Binding OffsetDeltaAngleDeg, StringFormat='{}{0:F3}°'}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- XYR 平台纠偏补偿量 -->
                            <TextBlock
                                Margin="0,14,0,4"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#FA8C16"
                                Text="XYR 对位平台相对补偿量 (Delta 驱动)" />
                            <Border
                                Padding="10"
                                Background="#FFF7E6"
                                BorderBrush="#FFD591"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <Grid Margin="0,2">
                                        <TextBlock FontSize="12" Foreground="#595959" Text="X 轴平移补偿量 (DeltaX)：" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="14"
                                            FontWeight="Black"
                                            Foreground="#D4380D"
                                            Text="{Binding CompDeltaX, StringFormat='{}{0:F4} mm'}" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock FontSize="12" Foreground="#595959" Text="Y 轴平移补偿量 (DeltaY)：" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="14"
                                            FontWeight="Black"
                                            Foreground="#D4380D"
                                            Text="{Binding CompDeltaY, StringFormat='{}{0:F4} mm'}" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock FontSize="12" Foreground="#595959" Text="R 轴旋转补偿角 (DeltaAngle)：" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="14"
                                            FontWeight="Black"
                                            Foreground="#D4380D"
                                            Text="{Binding CompDeltaAngle, StringFormat='{}{0:F3}°'}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 纠偏后绝对目标物理坐标 -->
                            <TextBlock
                                Margin="0,12,0,4"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#52C41A"
                                Text="修正后绝对目标物理坐标 (Corrected)" />
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Margin="0,0,4,0"
                                    Padding="8"
                                    Background="#F6FFED"
                                    CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock FontSize="11" Foreground="#8C8C8C" Text="绝对目标 X (mm)" />
                                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#389E0D" Text="{Binding CorrectedTargetX, StringFormat='{}{0:F3}'}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    Padding="8"
                                    Background="#F6FFED"
                                    CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock FontSize="11" Foreground="#8C8C8C" Text="绝对目标 Y (mm)" />
                                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#389E0D" Text="{Binding CorrectedTargetY, StringFormat='{}{0:F3}'}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
