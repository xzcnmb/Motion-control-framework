<Window
    x:Class="Sophon.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:views="clr-namespace:Sophon.UI.Views"
    Title="运动控制上位机"
    Width="1440"
    Height="880"
    MinWidth="1100"
    MinHeight="700"
    prism:ViewModelLocator.AutoWireViewModel="True"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="46"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="#F0F2F5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Panel.ZIndex="200">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="/Resources/logo.png" Height="24" Width="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="运动控制上位机" FontSize="16" FontWeight="SemiBold" Foreground="#262626" VerticalAlignment="Center" />
                        <Border Margin="12,0,0,0" Background="#E6F7FF" BorderBrush="#91D5FF" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="现场运行" FontSize="11" Foreground="#1890FF" FontWeight="Medium" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnMinimize" Style="{StaticResource ShellTitleButtonStyle}" ToolTip="最小化" Click="OnMinimizeClicked">
                            <Path Data="M0,0 L12,0" Stroke="#595959" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="BtnMaximize" Style="{StaticResource ShellTitleButtonStyle}" ToolTip="最大化" Click="OnMaximizeClicked">
                            <Path x:Name="MaximizePath" Data="M0,0 L10,0 L10,10 L0,10 Z" Stroke="#595959" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource ShellCloseButtonStyle}" ToolTip="关闭系统" Click="OnCloseClicked">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#595959" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,1,0">
                        <views:SideView />
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <ContentControl x:Name="ContentHost" Grid.Row="0" Background="#F0F2F5" prism:RegionManager.RegionName="ContentRegion" />

                        <Border Grid.Row="1" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0">
                            <views:BottomView VerticalAlignment="Center" />
                        </Border>

                        <hc:ScrollViewer
                            Grid.Row="0"
                            Margin="0,10,16,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            VerticalScrollBarVisibility="Hidden">
                            <StackPanel Margin="5" hc:Growl.GrowlParent="True" />
                        </hc:ScrollViewer>
                    </Grid>
                </Grid>

                <views:UserView
                    Panel.ZIndex="100"
                    Visibility="{Binding DataContext.ShowLoginOverlay, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" />

                <hc:ScrollViewer
                    Panel.ZIndex="300"
                    Margin="0,10,16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="5" hc:Growl.GrowlParent="True" />
                </hc:ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
