<UserControl
    x:Class="Sophon.UI.Views.Teach.TeachView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="750"
    d:DesignWidth="1150"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#F3F6F9"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：点动面板与实时坐标显示 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,12"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="#1F2937"
                    Text="点动与示教控制面板" />

                <!-- 轴选择与实时坐标 -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontWeight="SemiBold"
                        Text="选择控制轴：" />
                    <ComboBox
                        Height="32"
                        DisplayMemberPath="AxisName"
                        ItemsSource="{Binding AxisList}"
                        SelectedItem="{Binding SelectedAxis}" />

                    <Border
                        Margin="0,10,0,0"
                        Padding="10"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <TextBlock Foreground="#6B7280" Text="当前物理坐标：" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontWeight="Bold"
                                    Foreground="#1D4ED8"
                                    Text="{Binding SelectedAxis.Position, StringFormat={}{0:F3} mm}" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Foreground="#6B7280" Text="当前实时速度：" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Text="{Binding SelectedAxis.Velocity, StringFormat={}{0:F2} mm/s}" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Foreground="#6B7280" Text="使能/回零状态：" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        FontWeight="Bold"
                                        Foreground="#1D4ED8"
                                        Text="{Binding SelectedAxis.Enabled, StringFormat=使能:{0}}" />
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="#1D4ED8"
                                        Text="{Binding SelectedAxis.Homed, StringFormat=回零:{0}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 速度与步进模式设置 -->
                <Border
                    Grid.Row="2"
                    Margin="0,0,0,12"
                    Padding="10"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,6"
                            FontWeight="SemiBold"
                            Text="速度档位与步长设置" />
                        <Grid Margin="0,4">
                            <TextBlock VerticalAlignment="Center" Text="速度模式：" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <RadioButton
                                    Margin="0,0,12,0"
                                    Content="微调(低速)"
                                    IsChecked="{Binding IsLowSpeed}" />
                                <RadioButton Content="高速" IsChecked="{Binding IsHighSpeed}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,8,0,4"
                            VerticalAlignment="Center"
                            Text="增量步进距离 (mm)：" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <RadioButton
                                Margin="4,0"
                                Content="0.01"
                                IsChecked="{Binding Step001}" />
                            <RadioButton
                                Margin="4,0"
                                Content="0.1"
                                IsChecked="{Binding Step01}" />
                            <RadioButton
                                Margin="4,0"
                                Content="1.0"
                                IsChecked="{Binding Step1}" />
                            <RadioButton
                                Margin="4,0"
                                Content="10.0"
                                IsChecked="{Binding Step10}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 点动控制按钮组 -->
                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontWeight="SemiBold"
                        Text="轴运动操作：" />
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Height="36"
                            Command="{Binding EnableAxisCommand}"
                            Content="使能当前轴"
                            Style="{StaticResource ButtonDashedSuccess}" />
                        <Button
                            Grid.Column="2"
                            Height="36"
                            Command="{Binding DisableAxisCommand}"
                            Content="下使能"
                            Style="{StaticResource ButtonDashedDanger}" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Height="36"
                            Command="{Binding JogNegativeCommand}"
                            Content="连续 JOG -"
                            Style="{StaticResource ButtonDashedInfo}" />
                        <Button
                            Grid.Column="2"
                            Height="36"
                            Command="{Binding JogPositiveCommand}"
                            Content="连续 JOG +"
                            Style="{StaticResource ButtonDashedInfo}" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Height="36"
                            Command="{Binding StepNegativeCommand}"
                            Content="步进 -"
                            Style="{StaticResource ButtonDashedSuccess}" />
                        <Button
                            Grid.Column="2"
                            Height="36"
                            Command="{Binding StepPositiveCommand}"
                            Content="步进 +"
                            Style="{StaticResource ButtonDashedSuccess}" />
                    </Grid>

                    <Button
                        Margin="0,6,0,0"
                        Height="36"
                        Command="{Binding StopAxisCommand}"
                        Content="停止单轴"
                        Style="{StaticResource ButtonDashedDanger}" />
                </StackPanel>

                <!-- 快速捕获保存 -->
                <Border
                    Grid.Row="4"
                    Padding="10"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="示教点捕获录入" />
                        <Grid Margin="0,2">
                            <TextBlock VerticalAlignment="Center" Text="点位名称：" />
                            <TextBox
                                Width="180"
                                Height="28"
                                HorizontalAlignment="Right"
                                Text="{Binding NewPointName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock VerticalAlignment="Center" Text="分组名：" />
                            <TextBox
                                Width="180"
                                Height="28"
                                HorizontalAlignment="Right"
                                Text="{Binding NewPointGroup, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock VerticalAlignment="Center" Text="运行速度：" />
                            <TextBox
                                Width="180"
                                Height="28"
                                HorizontalAlignment="Right"
                                Text="{Binding NewPointSpeed, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock VerticalAlignment="Center" Text="点位说明：" />
                            <TextBox
                                Width="180"
                                Height="28"
                                HorizontalAlignment="Right"
                                Text="{Binding NewPointDescription, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Button
                            Margin="0,10,0,0"
                            Height="36"
                            Command="{Binding CapturePointCommand}"
                            Content="捕获当前坐标并保存"
                            Style="{StaticResource ButtonDashedPrimary}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧：示教点列表与点位组管理 -->
        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>

                <!-- 示教点列表标题与操作按钮 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#1F2937"
                        Text="已保存示教点列表" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Margin="6,0"
                            Command="{Binding RunToPointCommand}"
                            Content="运行到选中点"
                            Style="{StaticResource ButtonDashedSuccess}" />
                        <Button
                            Margin="6,0"
                            Command="{Binding DeletePointCommand}"
                            Content="删除选中点"
                            Style="{StaticResource ButtonDashedDanger}" />
                        <Button
                            Margin="6,0"
                            Command="{Binding RefreshDataCommand}"
                            Content="刷新"
                            Style="{StaticResource ButtonDashedInfo}" />
                    </StackPanel>
                </Grid>

                <DataGrid
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    ItemsSource="{Binding PointsList}"
                    SelectedItem="{Binding SelectedPoint}"
                    Style="{StaticResource DataGridCommonStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Name}"
                            Header="点位名称"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Group}"
                            Header="所属分组"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding Speed}"
                            Header="速度(mm/s)"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="180"
                            Binding="{Binding Description}"
                            Header="描述"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding CreateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                            Header="创建时间"
                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 点位组标题与操作 -->
                <Grid Grid.Row="2" Margin="0,12,0,8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#1F2937"
                        Text="示教点位组（轨迹序列）" />
                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding RunGroupCommand}"
                        Content="运行选重点位组"
                        Style="{StaticResource ButtonDashedPrimary}" />
                </Grid>

                <DataGrid
                    Grid.Row="3"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    ItemsSource="{Binding GroupsList}"
                    SelectedItem="{Binding SelectedGroup}"
                    Style="{StaticResource DataGridCommonStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding Name}"
                            Header="组名称"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding PointIds.Count}"
                            Header="包含点数"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Description}"
                            Header="组描述"
                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
