<UserControl
    x:Class="Sophon.UI.Views.DeviceControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#F4F6F9"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="DeviceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#E8ECEF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="2" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <TabControl Background="Transparent" BorderThickness="0">
            <!-- TAB 1: 气动与夹爪执行机构 -->
            <TabItem Header="气缸与夹爪控制">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 说明横幅 -->
                    <Border Grid.Row="0" Background="#F6FFED" BorderBrush="#B7EB8F" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡 气动五重可靠性保护已激活：" FontWeight="SemiBold" Foreground="#389E0D" FontSize="13" />
                            <TextBlock Text="双电控防烧线圈短暂脉冲输出(200ms) · 双到位磁性开关确认 · 同组空间互锁防碰撞 · 启动前置安全门与气压校验。"
                                       Foreground="#262626" FontSize="13" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 气缸卡片列表 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Cylinders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DeviceCardStyle}" Width="360" Margin="0,0,16,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 标题与状态 -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#262626" Margin="0,0,8,0" />
                                                <Border Background="#F5F5F5" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding ValveText}" FontSize="11" Foreground="#595959" />
                                                </Border>
                                            </StackPanel>

                                            <Border HorizontalAlignment="Right" Background="#FAFAFA" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                                <TextBlock Text="{Binding PositionText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding PositionColor}" />
                                            </Border>
                                        </Grid>

                                        <!-- 磁性开关与传感器指示灯 -->
                                        <Border Grid.Row="1" Background="#FAFAFA" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 缩回传感器 -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#D9D9D9" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HomeSensorActive}" Value="True">
                                                                        <Setter Property="Fill" Value="#1890FF" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="缩回/夹紧到位" FontSize="12" Foreground="#595959" />
                                                </StackPanel>

                                                <!-- 伸出传感器 -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#D9D9D9" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding WorkSensorActive}" Value="True">
                                                                        <Setter Property="Fill" Value="#52C41A" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="伸出/张开到位" FontSize="12" Foreground="#595959" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 互锁组与DO映射信息 -->
                                        <StackPanel Grid.Row="2" Margin="0,0,0,14">
                                            <TextBlock Text="{Binding InterlockGroup, StringFormat='互锁保护组: {0}'}" FontSize="12" Foreground="#8C8C8C" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Definition.WorkDoName, StringFormat='工作线圈DO: {0}'}" FontSize="11" Foreground="#BFBFBF" />
                                        </StackPanel>

                                        <!-- 手动动作操作按钮 -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Content="◀ 缩回 / 夹紧 (Home)"
                                                    Command="{Binding MoveHomeCommand}"
                                                    Style="{StaticResource ButtonDefault}"
                                                    Height="36" />

                                            <Button Grid.Column="2" Content="伸出 / 张开 (Work) ▶"
                                                    Command="{Binding MoveWorkCommand}"
                                                    Style="{StaticResource ButtonPrimary}"
                                                    Height="36" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <!-- TAB 2: RS485 / 232 外设通讯 -->
            <TabItem Header="外设工业通讯 (485/232/Modbus)">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 顶部设备选择与总线状态 -->
                    <Border Grid.Row="0" Style="{StaticResource DeviceCardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="选择通讯设备：" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox Width="200" Height="34"
                                          ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedDevice}"
                                          DisplayMemberPath="Name" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                <Border Background="#F9F0FF" BorderBrush="#D3ADF7" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding SelectedDevice.Transport, StringFormat='协议: {0}'}" FontSize="12" Foreground="#722ED1" FontWeight="Medium" />
                                </Border>
                                <TextBlock Text="{Binding SelectedDevice.PortName, StringFormat='串口: {0}'}" FontSize="12" Foreground="#595959" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding SelectedDevice.BaudRate, StringFormat='波特率: {0}'}" FontSize="12" Foreground="#595959" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding SelectedDevice.SlaveAddress, StringFormat='站号: {0}'}" FontSize="12" Foreground="#595959" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding SelectedDevice.PollPeriodMs, StringFormat='采集节拍: {0}ms'}" FontSize="12" Foreground="#595959" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding PollStatus}" FontSize="12" Foreground="#8C8C8C" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Content="连接采集" Style="{StaticResource ButtonSuccess}" Height="34" Margin="0,0,8,0" Command="{Binding ConnectPollCommand}" />
                                <Button Content="停止采集" Style="{StaticResource ButtonDefault}" Height="34" Margin="0,0,8,0" Command="{Binding DisconnectPollCommand}" />
                                <Button Content="刷新点位" Style="{StaticResource ButtonDefault}" Height="34" Command="{Binding RefreshCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 中间点位实时监控表 -->
                    <Border Grid.Row="1" Style="{StaticResource DeviceCardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="外设点位采集快照（自动量纲缩放与字序还原）" FontSize="15" FontWeight="SemiBold" Foreground="#262626" Margin="0,0,0,10" />

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding SelectedDeviceTags}"
                                      SelectedItem="{Binding SelectedTag}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="#E8E8E8"
                                      VerticalGridLinesBrush="#E8E8E8"
                                      BorderThickness="1"
                                      BorderBrush="#E8E8E8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="点位标识" Binding="{Binding Name}" Width="150" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="当前实时工程量" Binding="{Binding Value, StringFormat='{}{0:F2}'}" Width="160" Foreground="#1677FF" FontSize="15" FontWeight="Bold" />
                                    <DataGridTextColumn Header="物理单位" Binding="{Binding Unit}" Width="90" />
                                    <DataGridTextColumn Header="Modbus区" Binding="{Binding Area}" Width="140" />
                                    <DataGridTextColumn Header="0基址" Binding="{Binding Address}" Width="90" />
                                    <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="110" />
                                    <DataGridCheckBoxColumn Header="允许写入" Binding="{Binding Writable}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- 底部交互写入面板 -->
                    <Border Grid.Row="2" Style="{StaticResource DeviceCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="向外设点位写入：" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="当前选中点位: " FontSize="13" Foreground="#595959" />
                                <TextBlock Text="{Binding SelectedTag.Name}" FontSize="13" FontWeight="Bold" Foreground="#1677FF" Margin="4,0,0,0" />
                            </StackPanel>

                            <TextBox Grid.Column="2" Height="34" Text="{Binding WriteTargetValue, Mode=TwoWay}"
                                     hc:BorderElement.CornerRadius="4"
                                     hc:InfoElement.Placeholder="输入目标工程量数值"
                                     Margin="0,0,12,0" />

                            <Button Grid.Column="3" Content="下发写入 (范围安全防护)"
                                    Style="{StaticResource ButtonPrimary}"
                                    Height="34"
                                    Command="{Binding WriteTagCommand}" />

                            <TextBlock Grid.Column="4" Text="⚠ 写入操作受点位 WriteMin / WriteMax 白名单约束，禁止非法超限指令。"
                                       Foreground="#8C8C8C" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
