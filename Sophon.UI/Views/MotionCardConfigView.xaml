<UserControl
    x:Class="Sophon.UI.Views.MotionCardConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#F4F6F9"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ConfigCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#E8ECEF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="2" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. 方案管理 + 控制卡选型（厂商 → 脉冲/总线 → 系列 → 型号） -->
        <Border Grid.Row="0" Style="{StaticResource ConfigCardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 方案管理行 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="控制卡方案：" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="200" Height="34"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="ProfileName"
                              Margin="0,0,12,0" />

                    <Button Content="+ 新建方案" Style="{StaticResource ButtonPrimary}" Height="34" Command="{Binding AddProfileCommand}" Margin="0,0,8,0" />
                    <Button Content="删除方案" Style="{StaticResource ButtonDanger}" Height="34" Command="{Binding DeleteProfileCommand}" Margin="0,0,16,0" />

                    <Button Content="设为默认方案" Style="{StaticResource ButtonDefault}" Height="34" Command="{Binding SetAsActiveCommand}" Margin="0,0,8,0" />
                    <Button Content="保存并应用" Style="{StaticResource ButtonSuccess}" Height="34" Command="{Binding SaveAndApplyCommand}" />

                    <!-- 校验状态标签 -->
                    <Border Margin="24,0,0,0" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Background="#F5F5F5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="校验状态：" FontSize="13" Foreground="#595959" />
                            <TextBlock Text="{Binding ValidationStatus}" FontSize="13" FontWeight="Bold" Foreground="{Binding ValidationColor}" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 选型级联行 -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.6*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="1. 厂商" FontSize="12" Foreground="#8C8C8C" Margin="0,0,0,4" />
                        <ComboBox Height="34"
                                  ItemsSource="{Binding VendorOptions}"
                                  SelectedItem="{Binding SelectedVendor}"
                                  DisplayMemberPath="Display"
                                  hc:BorderElement.CornerRadius="4" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="2. 接口类型（脉冲 / 总线）" FontSize="12" Foreground="#8C8C8C" Margin="0,0,0,4" />
                        <ComboBox Height="34"
                                  ItemsSource="{Binding InterfaceOptions}"
                                  SelectedItem="{Binding SelectedInterface}"
                                  DisplayMemberPath="Display"
                                  hc:BorderElement.CornerRadius="4" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="3. 系列" FontSize="12" Foreground="#8C8C8C" Margin="0,0,0,4" />
                        <ComboBox Height="34"
                                  ItemsSource="{Binding SeriesOptions}"
                                  SelectedItem="{Binding SelectedSeries}"
                                  DisplayMemberPath="Display"
                                  hc:BorderElement.CornerRadius="4" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="4. 型号" FontSize="12" Foreground="#8C8C8C" Margin="0,0,0,4" />
                        <ComboBox Height="34"
                                  ItemsSource="{Binding ModelOptions}"
                                  SelectedItem="{Binding SelectedModel}"
                                  DisplayMemberPath="DisplayName"
                                  hc:BorderElement.CornerRadius="4" />
                    </StackPanel>
                </Grid>

                <!-- 型号相关字段：按型号能力显示，不让人再手填型号 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="卡号 / 板卡序号" FontSize="12" Foreground="#8C8C8C" Margin="0,0,0,4" />
                        <TextBox Height="34" Text="{Binding SelectedProfile.CardNo, Mode=TwoWay}" hc:BorderElement.CornerRadius="4" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0"
                                Visibility="{Binding ShowConnectionString, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ConnectionStringLabel}" FontSize="12" Foreground="#8C8C8C" Margin="0,0,0,4" />
                        <TextBox Height="34" Text="{Binding SelectedProfile.ConnectionString, Mode=TwoWay}" hc:BorderElement.CornerRadius="4" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Visibility="{Binding ShowConfigFile, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ConfigFileLabel}" FontSize="12" Foreground="#8C8C8C" Margin="0,0,0,4" />
                        <TextBox Height="34" Text="{Binding SelectedProfile.ConfigFilePath, Mode=TwoWay}" hc:BorderElement.CornerRadius="4" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. 平台差异提示 + 未接入警告 -->
        <StackPanel Grid.Row="1">
            <Border Background="#E6F4FF" BorderBrush="#91CAFF" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,8">
                <StackPanel>
                    <!-- 当前选型只读摘要：卡型 / 主机接口 / 适配状态，复用 MotionCardCatalog.Display -->
                    <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" Foreground="#1677FF" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NativeLibraryText}" Foreground="#1677FF" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PlatformHint}" Foreground="#262626" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Background="#FFF7E6" BorderBrush="#FFD591" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,12"
                    Visibility="{Binding ShowAdapterWarning, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding AdapterWarning}" Foreground="#AD4E00" FontSize="12" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- 3. 轴参数配置表 (DataGrid) -->
        <Border Grid.Row="2" Style="{StaticResource ConfigCardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="轴参数配置清单（脉冲当量、加减速度、速度与软限位）" FontSize="15" FontWeight="SemiBold" Foreground="#262626" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+ 添加轴" Style="{StaticResource ButtonPrimary}" Height="30" Command="{Binding AddAxisCommand}" Margin="0,0,8,0" />
                        <Button Content="- 删除选中轴" Style="{StaticResource ButtonDanger}" Height="30" Command="{Binding DeleteAxisCommand}" />
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Axes}"
                          SelectedItem="{Binding SelectedAxis}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#E8E8E8"
                          VerticalGridLinesBrush="#E8E8E8"
                          BorderThickness="1"
                          BorderBrush="#E8E8E8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="轴号" Binding="{Binding AxisId}" Width="60" />
                        <DataGridTextColumn Header="轴名称" Binding="{Binding Name}" Width="90" />
                        <DataGridTextColumn Header="物理单位" Binding="{Binding Unit}" Width="70" />
                        <DataGridTextColumn Header="脉冲当量（脉冲/单位）" Binding="{Binding PulsePerUnit}" Width="150" />
                        <DataGridCheckBoxColumn Header="方向取反" Binding="{Binding DirectionInvert}" Width="75" />
                        <DataGridTextColumn Header="最大速度" Binding="{Binding MaxSpeed}" Width="85" />
                        <DataGridTextColumn Header="加速度" Binding="{Binding MaxAccel}" Width="85" />
                        <DataGridTextColumn Header="减速度" Binding="{Binding MaxDecel}" Width="85" />
                        <DataGridTextColumn Header="加加速度" Binding="{Binding MaxJerk}" Width="75" />
                        <DataGridCheckBoxColumn Header="软限位" Binding="{Binding SoftLimitEnabled}" Width="65" />
                        <DataGridTextColumn Header="负软限位（最小值）" Binding="{Binding SoftLimitMin}" Width="110" />
                        <DataGridTextColumn Header="正软限位（最大值）" Binding="{Binding SoftLimitMax}" Width="110" />
                        <DataGridCheckBoxColumn Header="硬限位" Binding="{Binding HardLimitEnabled}" Width="65" />
                        <DataGridTextColumn Header="正限位 IO" Binding="{Binding LimitPositiveIoName}" Width="110" />
                        <DataGridTextColumn Header="负限位 IO" Binding="{Binding LimitNegativeIoName}" Width="110" />
                        <DataGridTextColumn Header="回零速度" Binding="{Binding HomeSpeed}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 4. 校验不合规提示栏 -->
        <Border Grid.Row="3" Background="#FFF1F0" BorderBrush="#FFA39E" BorderThickness="1" CornerRadius="6" Padding="14,10"
                Visibility="{Binding HasValidationMessages, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel>
                <TextBlock Text="⚠ 当前配置方案存在以下不合规项，请修正：" FontWeight="Bold" Foreground="#CF1322" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding ValidationMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="#CF1322" FontSize="12" Margin="4,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
