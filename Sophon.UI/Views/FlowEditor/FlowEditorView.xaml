<UserControl
    x:Class="Sophon.UI.Views.FlowEditor.FlowEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:Sophon.UI.ViewModels.FlowEditor"
    prism:ViewModelLocator.AutoWireViewModel="True"
    d:DesignHeight="850"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <Grid Background="#F0F2F5">
        <Grid.ColumnDefinitions>
            <!-- 左侧：节点工具箱 -->
            <ColumnDefinition Width="230" MinWidth="180" MaxWidth="320" />
            <ColumnDefinition Width="Auto" />
            <!-- 中间：工作区（工具栏 + Nodify 画布 + 日志跟踪） -->
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <!-- 右侧：属性面板 -->
            <ColumnDefinition Width="290" MinWidth="220" MaxWidth="400" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧工具箱 ==================== -->
        <Border Grid.Column="0" Background="White" Margin="8,8,0,8" CornerRadius="8" Effect="{StaticResource EffectShadow1}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <Border Grid.Row="0" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="12,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M4,4 L10,4 L10,10 L4,10 Z M14,4 L20,4 L20,10 L14,10 Z M4,14 L10,14 L10,20 L4,20 Z M14,14 L20,14 L20,20 L14,20 Z" Fill="#1890FF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="节点工具箱" FontSize="15" FontWeight="Bold" Foreground="#262626" />
                        </StackPanel>
                        <TextBlock Text="双击将节点添加至流程画布" FontSize="11" Foreground="#8C8C8C" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 动态分类列表 -->
                <hc:ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="4,4">
                    <ItemsControl ItemsSource="{Binding ToolboxGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding CategoryName}" IsExpanded="True" Margin="0,2,0,4" Padding="0,2">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F9FAFB" BorderBrush="#F0F0F0" BorderThickness="1" CornerRadius="4" Margin="2,2" Padding="8,6" Cursor="Hand">
                                                    <Border.InputBindings>
                                                        <MouseBinding Gesture="LeftDoubleClick"
                                                                      Command="{Binding DataContext.AddNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Border.InputBindings>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#E6F7FF" />
                                                                    <Setter Property="BorderBrush" Value="#91D5FF" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Background="{Binding CategoryBrush}" CornerRadius="2" />

                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#262626" />
                                                            <TextBlock Text="{Binding NodeType}" FontSize="10" Foreground="#8C8C8C" />
                                                        </StackPanel>

                                                        <Button Grid.Column="2"
                                                                Content="+"
                                                                ToolTip="添加节点"
                                                                Width="22" Height="22"
                                                                FontSize="14"
                                                                Padding="0"
                                                                Style="{StaticResource ButtonDefault}"
                                                                Command="{Binding DataContext.AddNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </hc:ScrollViewer>
            </Grid>
        </Border>

        <!-- 分割条 1 -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

        <!-- ==================== 中间：工作区 ==================== -->
        <Grid Grid.Column="2" Margin="4,8,4,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="180" MinHeight="100" MaxHeight="400" />
            </Grid.RowDefinitions>

            <!-- 顶部操作工具栏 -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,0,6" Effect="{StaticResource EffectShadow1}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 流程名称 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="流程名:" FontSize="13" Foreground="#595959" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <hc:TextBox Text="{Binding FlowName, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="30" FontSize="13" Margin="0,0,12,0" />
                    </StackPanel>

                    <!-- 文件与编辑操作 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="新建" Command="{Binding NewFlowCommand}" Style="{StaticResource ButtonDefault}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="打开..." Command="{Binding OpenFlowCommand}" Style="{StaticResource ButtonDefault}" Height="30" Padding="10,0" Margin="0,0,6,0" />

                        <!-- 快速打开已存流程 -->
                        <ComboBox ItemsSource="{Binding SavedFlowNames}" SelectedItem="{Binding SelectedSavedFlow}" Width="130" Height="30" Margin="0,0,6,0" ToolTip="选择并载入已保存的流程" />

                        <Button Content="保存" Command="{Binding SaveFlowCommand}" Style="{StaticResource ButtonPrimary}" Height="30" Padding="12,0" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StatusHint}" FontSize="11" Foreground="#52C41A" VerticalAlignment="Center" Margin="8,0,6,0" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                        <Button Content="校验图" Command="{Binding ValidateFlowCommand}" Style="{StaticResource ButtonSuccess}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="导入旧版V1" Command="{Binding ImportV1Command}" Style="{StaticResource ButtonDefault}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="删除节点" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource ButtonDanger}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="导出工程" Command="{Binding ExportProjectCommand}" Style="{StaticResource ButtonDefault}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="导入工程" Command="{Binding ImportProjectCommand}" Style="{StaticResource ButtonDefault}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                    </StackPanel>

                    <!-- 流程运行控制 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="1" Height="20" Fill="#D9D9D9" Margin="6,0,12,0" />
                        <Button Content="▶ 运行流程" Command="{Binding RunFlowCommand}" Style="{StaticResource ButtonSuccess}" Height="30" Padding="12,0" Margin="0,0,6,0" FontWeight="SemiBold" />
                        <Button Content="⏸ 暂停" Command="{Binding PauseFlowCommand}" Style="{StaticResource ButtonWarning}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="⏩ 继续" Command="{Binding ResumeFlowCommand}" Style="{StaticResource ButtonPrimary}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="⏹ 停止" Command="{Binding StopFlowCommand}" Style="{StaticResource ButtonDanger}" Height="30" Padding="12,0" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Nodify 画布区 -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" ClipToBounds="True" Effect="{StaticResource EffectShadow1}">
                <nodify:NodifyEditor
                    ItemsSource="{Binding Nodes}"
                    SelectedItems="{Binding SelectedNodes, Mode=TwoWay}"
                    Connections="{Binding Connections}"
                    PendingConnection="{Binding PendingConnection}"
                    ItemContainerStyle="{StaticResource FlowNodeContainerStyle}"
                    ConnectionTemplate="{StaticResource FlowConnectionTemplate}"
                    PendingConnectionTemplate="{StaticResource FlowPendingConnectionTemplate}"
                    ViewportLocation="{Binding ViewportLocation, Mode=TwoWay}"
                    ViewportZoom="{Binding ViewportZoom, Mode=TwoWay}"
                    Focusable="True">
                    <nodify:NodifyEditor.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                    </nodify:NodifyEditor.InputBindings>
                    <nodify:NodifyEditor.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FlowNodeViewModel}">
                            <!-- 节点卡片主体 -->
                            <Border Width="220" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="6" Effect="{StaticResource EffectShadow2}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#1890FF" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- 节点顶栏：类别色带与运行状态指示 -->
                                    <Border Grid.Row="0" Background="{Binding HeaderBrush}" CornerRadius="5,5,0,0" Padding="10,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 节点名称与类型 -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding NodeType}" FontSize="10" Foreground="#E6F7FF" Opacity="0.9" />
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="{Binding StateBrush}" CornerRadius="10" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding StateText}" FontSize="10" Foreground="White" FontWeight="Bold" />
                                            </Border>

                                            <Button Grid.Column="2" Content="×" Width="22" Height="22" Padding="0" FontSize="12" FontWeight="Bold"
                                                    ToolTip="删除此节点"
                                                    Command="{Binding DataContext.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#00000000" Foreground="White" BorderThickness="0"
                                                    Cursor="Hand" />
                                        </Grid>
                                    </Border>

                                    <!-- 节点端口区（输入 In / 输出 Out） -->
                                    <Grid Grid.Row="1" Margin="6,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 输入端口列表（左侧） -->
                                        <ItemsControl Grid.Column="0" ItemsSource="{Binding InputPorts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FlowPortViewModel}">
                                                    <nodify:NodeInput
                                                        Header="{Binding Name}"
                                                        Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                        IsConnected="{Binding IsConnected}"
                                                        FontSize="11"
                                                        Margin="0,3" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 输出端口列表（右侧） -->
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding OutputPorts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FlowPortViewModel}">
                                                    <nodify:NodeOutput
                                                        Header="{Binding Name}"
                                                        Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                        IsConnected="{Binding IsConnected}"
                                                        FontSize="11"
                                                        Margin="0,3" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </nodify:NodifyEditor.ItemTemplate>
                </nodify:NodifyEditor>
            </Border>

            <!-- 分割条 2 -->
            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Margin="0,2" />

            <!-- 底部日志跟踪区 -->
            <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10,8" Effect="{StaticResource EffectShadow1}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="执行日志与节点追踪" FontSize="13" FontWeight="Bold" Foreground="#262626" />
                            <TextBlock Text="{Binding RunLogs.Count, StringFormat=' ({0} 条)'}" FontSize="12" Foreground="#8C8C8C" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="清空日志" Command="{Binding ClearLogsCommand}" Style="{StaticResource ButtonDefault}" Height="24" Padding="8,0" FontSize="11" />
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RunLogs}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="1" BorderBrush="#F0F0F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="100" />
                            <DataGridTextColumn Header="节点名称" Binding="{Binding NodeName}" Width="130" />
                            <DataGridTextColumn Header="节点类型" Binding="{Binding NodeType}" Width="110" />
                            <DataGridTemplateColumn Header="运行状态" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StateBrush}" CornerRadius="8" Padding="6,1" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding State}" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="详细信息" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 分割条 3 -->
        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

        <!-- ==================== 右侧属性面板 ==================== -->
        <Border Grid.Column="4" Background="White" Margin="0,8,8,8" CornerRadius="8" Effect="{StaticResource EffectShadow1}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <Border Grid.Row="0" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="12,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M19,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M9,17 L7,17 L7,7 L9,7 L9,17 Z M13,17 L11,17 L11,10 L13,10 L13,17 Z M17,17 L15,17 L15,13 L17,13 L17,17 Z" Fill="#1890FF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="节点属性配置" FontSize="15" FontWeight="Bold" Foreground="#262626" />
                    </StackPanel>
                </Border>

                <!-- 未选中节点提示 -->
                <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNode}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="请在画布中选中节点" FontSize="14" Foreground="#BFBFBF" HorizontalAlignment="Center" />
                        <TextBlock Text="以查看或编辑其属性参数" FontSize="11" Foreground="#BFBFBF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 属性详情区 -->
                <hc:ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,8">
                    <hc:ScrollViewer.Style>
                        <Style TargetType="hc:ScrollViewer">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNode}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:ScrollViewer.Style>

                    <StackPanel>
                        <!-- 节点基础信息 -->
                        <TextBlock Text="基础信息" FontSize="13" FontWeight="Bold" Foreground="#262626" Margin="0,0,0,8" />

                        <TextBlock Text="节点名称（可改）:" FontSize="12" Foreground="#595959" Margin="0,0,0,4" />
                        <hc:TextBox Text="{Binding SelectedNode.Name, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="12" Margin="0,0,0,10" />
                        <TextBlock Text="点画布节点即可改参数；Delete 或「删除节点」可删。改完点保存。" FontSize="11" Foreground="#8C8C8C" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="节点类型:" FontSize="11" Foreground="#8C8C8C" />
                                <TextBlock Text="{Binding SelectedNode.NodeType}" FontSize="12" FontWeight="SemiBold" Foreground="#1890FF" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="运行状态:" FontSize="11" Foreground="#8C8C8C" />
                                <Border Background="{Binding SelectedNode.StateBrush}" CornerRadius="8" Padding="6,1" HorizontalAlignment="Left" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding SelectedNode.StateText}" FontSize="11" Foreground="White" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="节点 ID:" FontSize="11" Foreground="#8C8C8C" />
                        <TextBlock Text="{Binding SelectedNode.Id}" FontSize="10" Foreground="#595959" TextWrapping="Wrap" Margin="0,2,0,12" />

                        <hc:Divider LineStroke="#F0F0F0" Margin="0,0,0,12" />

                        <!-- 动态参数属性列表 (基于 ParameterSchema) -->
                        <TextBlock Text="业务参数配置" FontSize="13" FontWeight="Bold" Foreground="#262626" Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding SelectedNode.ParameterEditors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ParameterEditorViewModel}">
                                    <Border Margin="0,0,0,10" Padding="0,2">
                                        <StackPanel>
                                            <!-- 标签与必填提示 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="#262626" FontWeight="Medium" />
                                                <TextBlock Text=" *" Foreground="#F5222D" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Type, StringFormat=' ({0})'}" FontSize="10" Foreground="#BFBFBF" Margin="4,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- 描述提示 -->
                                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#8C8C8C" TextWrapping="Wrap" Margin="0,0,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 动态编辑器分支 -->
                                            <!-- 1. 布尔类型开关 -->
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding BoolValue}" FontSize="12">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxBaseStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBool}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>

                                            <!-- 2. 整数类型 NumericUpDown -->
                                            <hc:NumericUpDown Value="{Binding IntValue}" DecimalPlaces="0" Height="28" FontSize="12">
                                                <hc:NumericUpDown.Style>
                                                    <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInt}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </hc:NumericUpDown.Style>
                                            </hc:NumericUpDown>

                                            <!-- 3. 浮点类型 NumericUpDown -->
                                            <hc:NumericUpDown Value="{Binding DoubleValue}" DecimalPlaces="2" Height="28" FontSize="12">
                                                <hc:NumericUpDown.Style>
                                                    <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDouble}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </hc:NumericUpDown.Style>
                                            </hc:NumericUpDown>

                                            <!-- 4. 示教点下拉 -->
                                            <ComboBox ItemsSource="{Binding PointOptions}" SelectedItem="{Binding PointValue, Mode=TwoWay}" IsEditable="False" Height="28" FontSize="12">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPoint}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>

                                            <!-- 5. 枚举下拉选择 ComboBox -->
                                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding EnumValue}" Height="28" FontSize="12">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnum}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>

                                            <!-- 6. JSON / 多行文本框 -->
                                            <hc:TextBox Text="{Binding JsonValue, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="65" FontSize="11" TextWrapping="Wrap">
                                                <hc:TextBox.Style>
                                                    <Style TargetType="hc:TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsJson}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </hc:TextBox.Style>
                                            </hc:TextBox>

                                            <!-- 6. 常规字符串文本框 -->
                                            <hc:TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="12">
                                                <hc:TextBox.Style>
                                                    <Style TargetType="hc:TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsString}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </hc:TextBox.Style>
                                            </hc:TextBox>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </hc:ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
