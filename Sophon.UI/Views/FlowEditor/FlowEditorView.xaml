<UserControl
    x:Class="Sophon.UI.Views.FlowEditor.FlowEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Sophon.UI.Helper"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:Sophon.UI.ViewModels.FlowEditor"
    prism:ViewModelLocator.AutoWireViewModel="True"
    d:DesignHeight="850"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- ColumnDefinition 不继承 DataContext，用 Freezable 代理把 VM 传给列宽限绑定 -->
        <conv:BindingProxy x:Key="EditorProxy" Data="{Binding}" />

        <conv:InspectorColumnLimitConverter x:Key="InspectorColumnLimitConverter" />

        <RotateTransform x:Key="Rotate90Transform" Angle="90" />

        <!-- 树里每个参数项（叶子）：一行内展示 名称 + 必填星号 + 类型提示 + 描述，标签下方内联对应类型的编辑器 -->
        <DataTemplate x:Key="ParameterEditorHeaderTemplate">
            <StackPanel Margin="0,3,0,3">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="#262626" FontWeight="Medium" />
                    <TextBlock Text=" *" Foreground="#F5222D" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Type, StringFormat=' ({0})'}" FontSize="10" Foreground="#BFBFBF" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#8C8C8C" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 参数编辑器内联在同一参数项中：七类互斥显示（bool/int/double/point/enum/json/string） -->
                <Border Margin="0,2,0,0" Padding="0,2">
                    <StackPanel>
                        <!-- 1. 布尔类型开关 -->
                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding BoolValue}" FontSize="12">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxBaseStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBool}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <!-- 2. 整数类型 NumericUpDown -->
                        <hc:NumericUpDown Value="{Binding IntValue}" DecimalPlaces="0" Height="28" FontSize="12">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInt}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>

                        <!-- 3. 浮点类型 NumericUpDown -->
                        <hc:NumericUpDown Value="{Binding DoubleValue}" DecimalPlaces="2" Height="28" FontSize="12">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDouble}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>

                        <!-- 4. 示教点下拉 -->
                        <ComboBox ItemsSource="{Binding PointOptions}" SelectedItem="{Binding PointValue, Mode=TwoWay}" IsEditable="False" Height="28" FontSize="12">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPoint}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <!-- 5. 枚举下拉选择 ComboBox -->
                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding EnumValue}" Height="28" FontSize="12">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnum}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <!-- 6. JSON / 多行文本框 -->
                        <hc:TextBox Text="{Binding JsonValue, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="65" FontSize="11" TextWrapping="Wrap">
                            <hc:TextBox.Style>
                                <Style TargetType="hc:TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsJson}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:TextBox.Style>
                        </hc:TextBox>

                        <!-- 6. 常规字符串文本框 -->
                        <hc:TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="12">
                            <hc:TextBox.Style>
                                <Style TargetType="hc:TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsString}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:TextBox.Style>
                        </hc:TextBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F0F2F5">
        <Grid.ColumnDefinitions>
            <!-- 中间：工作区（工具栏 + 节点工具箱 + Nodify 画布 + 日志跟踪） -->
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <!-- 右侧：属性面板（收起时宽限被压成细条，画布收回该列宽度；展开态仍可拖拽） -->
            <ColumnDefinition Width="290"
                              MinWidth="{Binding Data.IsInspectorCollapsed, Source={StaticResource EditorProxy}, Converter={StaticResource InspectorColumnLimitConverter}}"
                              MaxWidth="{Binding Data.IsInspectorCollapsed, Source={StaticResource EditorProxy}, Converter={StaticResource InspectorColumnLimitConverter}, ConverterParameter=Max}" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 中间：工作区 ==================== -->
        <Grid Grid.Column="0" Margin="4,8,4,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="180" MinHeight="100" MaxHeight="400" />
            </Grid.RowDefinitions>

            <!-- 顶部操作工具栏 -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,0,6" Effect="{StaticResource EffectShadow1}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 流程名称 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="流程名:" FontSize="13" Foreground="#595959" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <hc:TextBox Text="{Binding FlowName, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="30" FontSize="13" Margin="0,0,12,0" />
                    </StackPanel>

                    <!-- 文件与编辑操作 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="新建" Command="{Binding NewFlowCommand}" Style="{StaticResource ButtonDefault}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="打开..." Command="{Binding OpenFlowCommand}" Style="{StaticResource ButtonDefault}" Height="30" Padding="10,0" Margin="0,0,6,0" />

                        <!-- 快速打开已存流程 -->
                        <ComboBox ItemsSource="{Binding SavedFlowNames}" SelectedItem="{Binding SelectedSavedFlow}" Width="130" Height="30" Margin="0,0,6,0" ToolTip="选择并载入已保存的流程" />

                        <Button Content="保存" Command="{Binding SaveFlowCommand}" Style="{StaticResource ButtonPrimary}" Height="30" Padding="12,0" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StatusHint}" FontSize="11" Foreground="#52C41A" VerticalAlignment="Center" Margin="8,0,6,0" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                        <Button Content="校验图" Command="{Binding ValidateFlowCommand}" Style="{StaticResource ButtonSuccess}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="导入旧版V1" Command="{Binding ImportV1Command}" Style="{StaticResource ButtonDefault}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="删除节点" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource ButtonDanger}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="导出工程" Command="{Binding ExportProjectCommand}" Style="{StaticResource ButtonDefault}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="导入工程" Command="{Binding ImportProjectCommand}" Style="{StaticResource ButtonDefault}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                    </StackPanel>

                    <!-- 流程运行控制 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="1" Height="20" Fill="#D9D9D9" Margin="6,0,12,0" />
                        <Button Content="▶ 运行流程" Command="{Binding RunFlowCommand}" Style="{StaticResource ButtonSuccess}" Height="30" Padding="12,0" Margin="0,0,6,0" FontWeight="SemiBold" />
                        <Button Content="⏸ 暂停" Command="{Binding PauseFlowCommand}" Style="{StaticResource ButtonWarning}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="⏩ 继续" Command="{Binding ResumeFlowCommand}" Style="{StaticResource ButtonPrimary}" Height="30" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="⏹ 停止" Command="{Binding StopFlowCommand}" Style="{StaticResource ButtonDanger}" Height="30" Padding="12,0" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 画布行：左节点工具箱 + 右原画布。
                 工具栏在第 0 行仍占满整行宽度，不被工具箱挤窄；右侧参数面板列索引与折叠逻辑不变。 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：节点工具箱。有界独立滚动，分类再多也不会挤出画布；折叠只收内容区，标题行常驻，保证还能展开回来 -->
                <Border Grid.Column="0" Width="190" Background="White" CornerRadius="8" Margin="0,0,6,0"
                        Effect="{StaticResource EffectShadow1}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="节点工具箱" FontSize="13" FontWeight="Bold" Foreground="#262626" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="1" Content="«" FontSize="12" Foreground="#8C8C8C"
                                              x:Name="ToolboxCollapseToggle"
                                              IsChecked="False"
                                              ToolTip="折叠 / 展开节点工具箱">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Height" Value="20" />
                                            <Setter Property="Width" Value="20" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F0F0F0" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="4,6,4,10">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=ToolboxCollapseToggle}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <ItemsControl ItemsSource="{Binding ToolboxGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ToolboxGroupViewModel}">
                                        <!-- 一级：分类。点击仅展开 / 折叠，不产生任何添加动作 -->
                                        <Expander IsExpanded="True" Margin="0,1" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                    <Ellipse Width="8" Height="8" Fill="#1890FF" VerticalAlignment="Center" Margin="2,0,6,0" />
                                                    <TextBlock Text="{Binding CategoryName}" FontSize="13" FontWeight="SemiBold" Foreground="#262626" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Items.Count, StringFormat=' ({0})'}" FontSize="10" Foreground="#A6ADB4" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ToolboxItemViewModel}">
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding CategoryBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="#262626"
                                                                       ToolTip="{Binding Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <!-- 唯一添加通道：点「+」一次只加一个节点，参数即当前 ToolboxItem -->
                                                            <Button Grid.Column="2"
                                                                    Width="22"
                                                                    Height="22"
                                                                    Padding="0"
                                                                    Margin="4,0,0,0"
                                                                    Content="+"
                                                                    FontSize="13"
                                                                    FontWeight="Bold"
                                                                    Cursor="Hand"
                                                                    ToolTip="添加到画布"
                                                                    Style="{StaticResource ButtonDefault}"
                                                                    Command="{Binding DataContext.AddNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" ClipToBounds="True" Effect="{StaticResource EffectShadow1}">
                    <nodify:NodifyEditor
                        ItemsSource="{Binding Nodes}"
                        SelectedItems="{Binding SelectedNodes, Mode=TwoWay}"
                        Connections="{Binding Connections}"
                        PendingConnection="{Binding PendingConnection}"
                        ItemContainerStyle="{StaticResource FlowNodeContainerStyle}"
                        ConnectionTemplate="{StaticResource FlowConnectionTemplate}"
                        PendingConnectionTemplate="{StaticResource FlowPendingConnectionTemplate}"
                        RemoveConnectionCommand="{Binding RemoveConnectionCommand}"
                        ViewportLocation="{Binding ViewportLocation, Mode=TwoWay}"
                        ViewportZoom="{Binding ViewportZoom, Mode=TwoWay}"
                        Focusable="True">
                        <nodify:NodifyEditor.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                        </nodify:NodifyEditor.InputBindings>
                        <nodify:NodifyEditor.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FlowNodeViewModel}">
                                <!-- 节点卡片主体 -->
                                <Border Width="220" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="6" Effect="{StaticResource EffectShadow2}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#1890FF" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- 节点顶栏：类别色带与运行状态指示 -->
                                        <Border Grid.Row="0" Background="{Binding HeaderBrush}" CornerRadius="5,5,0,0" Padding="10,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 节点名称与类型 -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding NodeType}" FontSize="10" Foreground="#E6F7FF" Opacity="0.9" />
                                                </StackPanel>

                                                <Border Grid.Column="1" Background="{Binding StateBrush}" CornerRadius="10" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding StateText}" FontSize="10" Foreground="White" FontWeight="Bold" />
                                                </Border>

                                                <Button Grid.Column="2" Content="×" Width="22" Height="22" Padding="0" FontSize="12" FontWeight="Bold"
                                                        ToolTip="删除此节点"
                                                        Command="{Binding DataContext.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#00000000" Foreground="White" BorderThickness="0"
                                                        Cursor="Hand" />
                                            </Grid>
                                        </Border>

                                        <!-- 节点端口区（输入 In / 输出 Out） -->
                                        <Grid Grid.Row="1" Margin="6,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 输入端口列表（左侧） -->
                                            <ItemsControl Grid.Column="0" ItemsSource="{Binding InputPorts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:FlowPortViewModel}">
                                                        <nodify:NodeInput
                                                            Header="{Binding Name}"
                                                            Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                            IsConnected="{Binding IsConnected}"
                                                            FontSize="11"
                                                            Margin="0,3" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 输出端口列表（右侧） -->
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding OutputPorts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:FlowPortViewModel}">
                                                        <nodify:NodeOutput
                                                            Header="{Binding Name}"
                                                            Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                            IsConnected="{Binding IsConnected}"
                                                            FontSize="11"
                                                            Margin="0,3" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </nodify:NodifyEditor.ItemTemplate>
                    </nodify:NodifyEditor>
                </Border>
            </Grid>

            <!-- 分割条 2 -->
            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Margin="0,2" />

            <!-- 底部日志跟踪区 -->
            <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10,8" Effect="{StaticResource EffectShadow1}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="执行日志与节点追踪" FontSize="13" FontWeight="Bold" Foreground="#262626" />
                            <TextBlock Text="{Binding RunLogs.Count, StringFormat=' ({0} 条)'}" FontSize="12" Foreground="#8C8C8C" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="清空日志" Command="{Binding ClearLogsCommand}" Style="{StaticResource ButtonDefault}" Height="24" Padding="8,0" FontSize="11" />
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RunLogs}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="1" BorderBrush="#F0F0F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="100" />
                            <DataGridTextColumn Header="节点名称" Binding="{Binding NodeName}" Width="130" />
                            <DataGridTextColumn Header="节点类型" Binding="{Binding NodeType}" Width="110" />
                            <DataGridTemplateColumn Header="运行状态" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StateBrush}" CornerRadius="8" Padding="6,1" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding State}" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="详细信息" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 分割条 3（面板收起成细条时一并隐藏，细条态不允许拖宽） -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInspectorCollapsed}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <!-- ==================== 右侧节点属性面板（可整体收起为细条） ==================== -->
        <Border Grid.Column="2" Background="White" CornerRadius="8" Effect="{StaticResource EffectShadow1}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="0,8,8,8" />
                    <Style.Triggers>
                        <!-- 收起态收窄右侧间隙，让 32px 细条尽量占满该列 -->
                        <DataTrigger Binding="{Binding IsInspectorCollapsed}" Value="True">
                            <Setter Property="Margin" Value="0,8,4,8" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题行（收起态整行隐藏，宽度让给细条） -->
                <Border Grid.Row="0" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="12,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInspectorCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M9,17 L7,17 L7,7 L9,7 L9,17 Z M13,17 L11,17 L11,10 L13,10 L13,17 Z M17,17 L15,17 L15,13 L17,13 L17,17 Z" Fill="#1890FF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="节点属性配置" FontSize="15" FontWeight="Bold" Foreground="#262626" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Content="« 收起" FontSize="11" Foreground="#8C8C8C" Margin="4,0,0,0"
                                      ToolTip="收起右侧面板，画布获得这一列的宽度"
                                      IsChecked="{Binding IsInspectorCollapsed, Mode=TwoWay}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F0F0F0" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>
                </Border>

                <!-- 未选中节点提示（面板收起成细条时一并隐藏；收起触发器放最后以覆盖选中态） -->
                <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNode}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInspectorCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="请在画布中选中节点" FontSize="14" Foreground="#BFBFBF" HorizontalAlignment="Center" />
                        <TextBlock Text="以查看或编辑其属性参数" FontSize="11" Foreground="#BFBFBF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 属性详情区：树形节点检查器（选中态可见；面板收起时一并隐藏） -->
                <TreeView Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="12,8" Background="Transparent" BorderThickness="0">
                    <TreeView.Style>
                        <Style TargetType="TreeView">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNode}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInspectorCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.Style>

                    <!-- 根节点：节点编辑 -->
                    <TreeViewItem Header="{Binding SelectedNode.Name, StringFormat='节点编辑：{0}'}"
                                  IsExpanded="True" FontSize="13" FontWeight="Bold" Foreground="#262626">

                        <!-- 子菜单一：基础信息 -->
                        <TreeViewItem Header="基础信息" IsExpanded="True" FontSize="12" FontWeight="SemiBold" Foreground="#262626">
                            <StackPanel Margin="0,3,0,6">
                                <TextBlock Text="节点名称（可改）:" FontSize="12" Foreground="#595959" Margin="0,0,0,4" />
                                <hc:TextBox Text="{Binding SelectedNode.Name, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="12" Margin="0,0,0,8" />
                                <TextBlock Text="点画布节点即可改参数；Delete 或「删除节点」可删。改完点保存。" FontSize="11" Foreground="#8C8C8C" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="节点类型:" FontSize="11" Foreground="#8C8C8C" />
                                        <TextBlock Text="{Binding SelectedNode.NodeType}" FontSize="12" FontWeight="SemiBold" Foreground="#1890FF" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="运行状态:" FontSize="11" Foreground="#8C8C8C" />
                                        <Border Background="{Binding SelectedNode.StateBrush}" CornerRadius="8" Padding="6,1" HorizontalAlignment="Left" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding SelectedNode.StateText}" FontSize="11" Foreground="White" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="节点 ID:" FontSize="11" Foreground="#8C8C8C" />
                                <TextBlock Text="{Binding SelectedNode.Id}" FontSize="10" Foreground="#595959" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </TreeViewItem>

                        <!-- 子菜单二：业务参数配置（每个参数一个叶子子项：表头=名称/必填/类型/描述，行内联编辑器） -->
                        <TreeViewItem Header="业务参数配置" IsExpanded="True" FontSize="12" FontWeight="SemiBold" Foreground="#262626"
                                      ItemsSource="{Binding SelectedNode.ParameterEditors}">
                            <TreeViewItem.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <!-- 参数项必须是叶子：只设表头（标签+内联编辑器）。严禁给容器设 ItemsSource——
                                         参数自身会被当成自己的子项，ItemContainerStyle 再向子孙容器传播，无限递归导致 StackOverflow -->
                                    <Setter Property="Header" Value="{Binding}" />
                                    <Setter Property="HeaderTemplate" Value="{StaticResource ParameterEditorHeaderTemplate}" />
                                </Style>
                            </TreeViewItem.ItemContainerStyle>
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeView>

                <!-- 收起态：细条 + 展开按钮（宽度由列的宽限绑定压到 28px 左右） -->
                <Border Grid.Row="1" Background="White">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInspectorCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ToggleButton IsChecked="{Binding IsInspectorCollapsed, Mode=TwoWay}" ToolTip="展开节点编辑">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E6F7FF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <TextBlock Text="节点编辑 »" FontSize="12" Foreground="#595959" Width="56" Height="16"
                                   TextAlignment="Center" VerticalAlignment="Center"
                                   LayoutTransform="{StaticResource Rotate90Transform}" />
                    </ToggleButton>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
