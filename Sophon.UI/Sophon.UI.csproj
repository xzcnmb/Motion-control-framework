<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Sophon.UI</RootNamespace>
    <AssemblyName>Sophon.UI</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- XAML 引用的图标资源：SDK 不会自动把 PNG 当 WPF Resource，必须显式声明，否则 /Resources/*.png 加载不到 -->
  <ItemGroup>
    <Resource Include="Resources\Alarm.png" />
    <Resource Include="Resources\Axis.png" />
    <Resource Include="Resources\Close.png" />
    <Resource Include="Resources\History.png" />
    <Resource Include="Resources\Home.png" />
    <Resource Include="Resources\Infra.png" />
    <Resource Include="Resources\IO.png" />
    <Resource Include="Resources\Max.png" />
    <Resource Include="Resources\Min.png" />
    <Resource Include="Resources\Param.png" />
    <Resource Include="Resources\Protocol.png" />
    <Resource Include="Resources\Register.png" />
    <Resource Include="Resources\Station.png" />
    <Resource Include="Resources\User.png" />
    <Resource Include="Resources\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\Sophon.Contracts\Sophon.Contracts.csproj" />
    <ProjectReference Include="..\Sophon.Infrastructure\Sophon.Infrastructure.csproj" />
    <ProjectReference Include="..\Sophon.Motion\Sophon.Motion.csproj" />
    <ProjectReference Include="..\Sophon.Core\Sophon.Core.csproj" />
    <ProjectReference Include="..\Sophon.Application\Sophon.Application.csproj" />
    <ProjectReference Include="..\Sophon.Vision\Sophon.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Prism.Wpf" Version="9.0.537" />
    <PackageReference Include="Prism.Container.DryIoc" Version="9.0.106" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />
    <PackageReference Include="Nodify" Version="7.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>